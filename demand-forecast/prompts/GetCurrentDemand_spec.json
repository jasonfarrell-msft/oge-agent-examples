{
  "openapi": "3.0.0",
  "info": {
    "title": "Demand API",
    "description": "Provides demand information from the multiagent support function.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://func-multiagent-support-euse2-mx01.azurewebsites.net/api"
    }
  ],
  "paths": {
    "/demand": {
      "get": {
        "summary": "Get demand information",
        "operationId": "getDemand",
        "responses": {
          "200": {
            "description": "Successful response with demand data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "temperature": {
                      "type": "number",
                      "format": "float",
                      "description": "Current temperature"
                    },
                    "numberOfCustomers": {
                      "type": "number",
                      "description": "Number of customers"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  }
}